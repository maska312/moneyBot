# Database (Supabase / Neon PostgreSQL)
DATABASE_URL="postgres://postgres.your-supabase-id:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Google Gemini API Key (get free at https://aistudio.google.com)
GEMINI_API_KEY="AIzaSy..."

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Telegram Webhook Secret (random string for securing webhook)
TELEGRAM_WEBHOOK_SECRET="super-secret-family-key-2026"

# Family Secret Token (for iOS Shortcuts authorization)
FAMILY_SECRET_TOKEN="family-secret-money-token"

# App Public URL
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Telegram User IDs for Maksat and Bayana (can also be linked automatically on /start)
MAKSAT_TELEGRAM_ID="123456789"
BAYANA_TELEGRAM_ID="987654321"
